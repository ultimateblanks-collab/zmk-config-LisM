                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp A>,
                <&macro_release>,
                <&kp A &kp LCTRL>;

            label = "CA";
        };

        ctrl_t: ctrl_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
