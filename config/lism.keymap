        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp V>,
                <&macro_release>,
                <&kp V &kp LCTRL>;

            label = "PASTE";
