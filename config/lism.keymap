        ctrl_w: ctrl_w {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp W>,
                <&macro_release>,
                <&kp W &kp LCTRL>;

            label = "CTRL_W";
        };

        altleft: altleft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LEFT_ARROW &kp LALT>;

            label = "ALTLEFT";
        };

        altright: altright {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_wait_time 20>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RIGHT &kp LEFT_ALT>;

            label = "ALTRIGHT";
        };

        altup: altup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp UP_ARROW &kp LALT>;

            label = "ALTUP";
        };

        altdown: altdown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&kp DOWN>,
                <&macro_release>,
                <&kp DOWN_ARROW &kp LEFT_ALT>;

            label = "ALTDOWN";
        };

        L_yamakakko: lyk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp COMMA>,
                <&macro_release>,
                <&kp COMMA &kp LEFT_SHIFT>;

            label = "LYK";
        };

        R_yamakakko: Ryamak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp PERIOD>,
                <&macro_release>,
                <&kp PERIOD &kp LEFT_SHIFT>;

            label = "RYAMAK";
        };

        altesc: altesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT>,
                <&macro_wait_time 20>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp RIGHT_ALT>;

            label = "ALTESC";
        };

        saltesc: saltesc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp RIGHT_ALT &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&kp ESCAPE>,
                <&macro_release>,
                <&kp ESCAPE &kp RIGHT_ALT &kp RSHIFT>;

            label = "SALTESC";
        };

        ctrlplus: ctrlplus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHFT>,
                <&macro_wait_time 20>,
                <&kp SEMI>,
                <&macro_release>,
                <&kp SEMI &kp LCTRL &kp LSHFT>;

            label = "CTRLPLUS";
        };

        ctrlminus: ctrlminus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp MINUS>,
                <&macro_release>,
                <&kp MINUS &kp LCTRL>;

            label = "CTRLMINUS";
        };

        ctup: ctup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp UP_ARROW &kp LCTRL>;

            label = "CTUP";
        };

        ctdn: ctdn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp DOWN_ARROW>,
                <&macro_release>,
                <&kp DOWN_ARROW &kp LCTRL>;

            label = "CTDN";
        };

        ctlt: ctlt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp LEFT_ARROW>,
                <&macro_release>,
                <&kp LEFT_ARROW &kp LCTRL>;

            label = "CTLT";
        };

        ctrt: ctrt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 50>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp RIGHT &kp LCTRL>;

            label = "CTRT";
        };

        l_tyk: l_tyk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp RIGHT_BRACKET>,
                <&macro_release>,
                <&kp RIGHT_BRACKET &kp LEFT_SHIFT>;

            label = "L_TYK";
        };

        r_tyk: r_tyk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_wait_time 20>,
                <&kp NUHS>,
                <&macro_release>,
                <&kp NUHS &kp LEFT_SHIFT>;

            label = "R_TYK";
        };

        ctbs: ctbs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_wait_time 20>,
                <&kp BACKSPACE>,
                <&macro_release>,
                <&kp BACKSPACE &kp LCTRL>;

            label = "CTBS";
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        L_HRM: L_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "L_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        R_HRM: R_HRM {
            compatible = "zmk,behavior-hold-tap";
            label = "R_HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        L_THUMB: L_THUMB {
            compatible = "zmk,behavior-hold-tap";
            label = "L_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        R_THUMB: R_THUMB {
            compatible = "zmk,behavior-hold-tap";
            label = "R_THUMB";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        S_key: S_key {
            compatible = "zmk,behavior-sticky-key";
            label = "S_KEY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <500>;
        };

        C_W: C_W {
            compatible = "zmk,behavior-caps-word";
            label = "C_W";
            #binding-cells = <0>;
            continue-list = <INT_YEN INT_RO>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        coron: coron {
            compatible = "zmk,behavior-mod-morph";
            label = "CORON";
            bindings = <&kp PERIOD>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        semicoron: semicoron {
            compatible = "zmk,behavior-mod-morph";
            label = "SEMICORON";
            bindings = <&kp COMMA>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        hussexc: hussexc {
            compatible = "zmk,behavior-mod-morph";
            label = "HUSSEXC";
            bindings = <&hush>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        MML_KAKKO: MML_KAKKO {
            compatible = "zmk,behavior-mod-morph";
            label = "MML_KAKKO";
            bindings = <&lk>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        MMR_KAKKO: MMR_KAKKO {
            compatible = "zmk,behavior-mod-morph";
            label = "MMR_KAKKO";
            bindings = <&rk>, <&kp PERIOD>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        YOKOBOU: YOKOBOU {
            compatible = "zmk,behavior-mod-morph";
            label = "YOKOBOU";
            bindings = <&kp MINUS>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LSFT)>;
        };

        RMTwin: RMTwin {
            compatible = "zmk,behavior-hold-tap";
            label = "RMTWIN";
            bindings = <&kp>, <&YOKOBOU>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        L_LT: L_LT {
            compatible = "zmk,behavior-hold-tap";
            label = "L_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 39 40 41 36>;
            hold-trigger-on-release;
        };

        R_LT: R_LT {
            compatible = "zmk,behavior-hold-tap";
            label = "R_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        athutt: athutt {
            compatible = "zmk,behavior-mod-morph";
            label = "ATHUTT";
            bindings = <&kp LBKT>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        plper: plper {
            compatible = "zmk,behavior-mod-morph";
            label = "PLPER";
            bindings = <&pl>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        sl_sp: sl_sp {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_SP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        R_Th_space: R_Th_space {
            compatible = "zmk,behavior-hold-tap";
            label = "R_TH_SPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <170>;
            require-prior-idle-ms = <170>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <5 6 7 9 8 15 16 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 39 40 41 36>;
            hold-trigger-on-release;
        };

        SL_SP2: SL_SP2 {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_SP2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <185>;
            flavor = "balanced";
        };

        L_carte: L_carte {
            compatible = "zmk,behavior-hold-tap";
            label = "L_CARTE";
            bindings = <&kp>, <&calte>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
        };

        R_evalue: R_evalue {
            compatible = "zmk,behavior-hold-tap";
            label = "R_EVALUE";
            bindings = <&kp>, <&evalue>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "balanced";
        };

        L_THUMB3: L_THUMB3 {
            compatible = "zmk,behavior-hold-tap";
            label = "L_THUMB3";
            bindings = <&mo>, <&altesc>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 36 37 38 39 40 41>;
            hold-trigger-on-release;
        };

        uspl: uspl {
            compatible = "zmk,behavior-mod-morph";
            label = "USPL";
            bindings = <&us>, <&pl>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LSFT|MOD_LALT|MOD_LGUI)>;
        };

        MLSP: MLSP {
            compatible = "zmk,behavior-hold-tap";
            label = "MLSP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <16 37 36 18 26>;
        };

        SLSP: SLSP {
            compatible = "zmk,behavior-hold-tap";
            label = "SLSP";
            bindings = <&mo>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1>;
        };

        USPL_L5: USPL_L5 {
            compatible = "zmk,behavior-hold-tap";
            label = "USPL_L5";
            bindings = <&mo>, <&uspl>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <16 17 15 18>;
        };

        MINUS_L5: MINUS_L5 {
            compatible = "zmk,behavior-hold-tap";
            label = "MINUS_L5";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <15 16 17 18 7 36 37>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <7 8>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <17 18>;
        };

        inputmode {
            bindings = <&kp GRAVE>;
            key-positions = <16 13>;
        };

        af4 {
            bindings = <&endapp>;
            key-positions = <36 15>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <11 12>;
        };

        plus {
            bindings = <&plus>;
            key-positions = <2 1>;
        };

        VBE {
            bindings = <&VBE>;
            key-positions = <23 24>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <6 7>;
        };

        cw {
            bindings = <&C_W>;
            key-positions = <13 12 11>;
        };

        pgup {
            bindings = <&kp PG_UP>;
            key-positions = <2 3>;
        };

        pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <12 13>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <16 17>;
        };

        skey {
            bindings = <&sk LSHFT>;
            key-positions = <16 17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&L_HRM LWIN Q  &L_HRM LALT W    &L_HRM LCTRL E             &L_HRM LSHIFT R      &kp T                                                              &kp Y                &R_HRM RSHFT U  &R_HRM RCTRL I   &R_HRM RIGHT_ALT O  &R_HRM RIGHT_WIN P
&kp A          &kp S            &kp D                      &kp F                &kp G                                                              &kp H                &kp J           &MLSP 1 K        &kp L               &kp MINUS
&kp Z          &kp X            &kp C                      &kp V                &kp B                                                              &kp N                &kp M           &SL_SP2 2 COMMA  &kp PERIOD          &uspl
&athutt        &kp PRINTSCREEN  &L_THUMB 3 K_CONTEXT_MENU  &L_THUMB 5 LEFT_ALT  &L_THUMB 4 LCTRL  &L_carte LEFT_SHIFT 0    &R_evalue LEFT_SHIFT 0  &R_Th_space 2 SPACE  &none           &none            &hussexc            &kp SLASH
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                     &none     &none      &none  &none     &none
&none     &altesc       &none      &saltesc   &none                     &none     &mkp MB1   &none  &mkp MB2  &none
&none     &none         &none      &none      &none                     &none     &SLSP 2 0  &none  &none     &none
&none     &none         &none      &none      &none  &none    &mkp MB5  &mkp MB4  &none      &none  &none     &none
            >;
        };

        layer_2 {
            display-name = "Arrow";
            bindings = <
&L_HRM LWIN SEMI  &L_HRM LALT APOSTROPHE  &L_HRM LCTRL RBKT  &L_HRM LSHFT NUHS  &anp                               &none     &ctpgup         &kp UP_ARROW    &ctpgdn    &none
&dq               &sq                     &lk                &rk                &aster                             &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp END
&dollar           &kp INTERNATIONAL_3     &l_tyk             &r_tyk             &percent                           &none     &altesc         &none           &saltesc   &none
&none             &none                   &L_yamakakko       &R_yamakakko       &kp APOSTROPHE  &kp SEMI    &none  &none     &none           &none           &none      &none
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "NUM";
            bindings = <
&kp LWIN  &kp LEFT_ALT  &L_HRM LCTRL UP_ARROW  &kp LSHFT  &none                      &kp N0  &R_HRM RSHFT N7  &R_HRM RCTRL N8  &R_HRM RIGHT_ALT N9  &kp RWIN
&none     &kp LEFT      &kp DOWN_ARROW         &kp RIGHT  &none                      &kp N0  &kp NUMBER_4     &kp N5           &kp N6               &kp PERIOD
&none     &none         &none                  &none      &none                      &kp N0  &kp NUMBER_1     &kp NUMBER_2     &kp NUMBER_3         &kp SLASH
&none     &none         &kp NUMBER_0           &none      &kp SPACE  &none    &none  &mo 2   &none            &none            &none                &none
            >;
        };

        layer_4 {
            display-name = "FUNCTION";
            bindings = <
&kp LWIN     &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                    &kp F10  &kp F7  &kp F8  &kp F9  &none
&none        &none         &none      &none      &none                    &kp F11  &kp F4  &kp F5  &kp F6  &none
&none        &none         &none      &none      &none                    &kp F12  &kp F1  &kp F2  &kp F3  &none
&bootloader  &none         &none      &none      &none  &none    &evalue  &calte   &none   &none   &none   &bootloader
            >;
        };

        layer_5 {
            display-name = "Snipe";
            bindings = <
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                     &none          &kp TAB    &kp HOME  &stab     &none
&none     &none         &none      &none      &none                     &kp BACKSPACE  &kp ENTER  &kp TAB   &stab     &kp DELETE
&none     &none         &none      &none      &none                     &none          &altesc    &kp END   &saltesc  &none
&none     &none         &none      &none      &none  &none    &saltesc  &altesc        &none      &none     &none     &none
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &to 5   &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
