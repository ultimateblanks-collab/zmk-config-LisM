    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp Q              &kp W          &kp E                 &kp R                &kp T                                                              &kp Y                &kp U                 &kp I           &kp O          &kp P
&L_HRM LEFT_WIN A  &L_HRM LALT S  &L_HRM LCTRL D        &L_HRM LEFT_SHIFT F  &kp G                                                              &kp H                &R_HRM RIGHT_SHIFT J  &R_HRM RCTRL K  &R_HRM RALT L  &RMTwin RIGHT_WIN 0
&kp Z              &kp X          &kp C                 &kp V                &kp B                                                              &kp N                &kp M                 &semicoron      &coron         &kp SLASH
&hussexc           &kp PG_UP      &L_THUMB 5 PAGE_DOWN  &L_THUMB 3 TAB       &L_THUMB 4 HOME  &L_HRM LEFT_SHIFT END    &R_HRM LEFT_SHIFT ENTER  &R_Th_space 2 SPACE  &none                 &athutt         &plper         &altesc
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        layer_1 {
            display-name = "Mouse";
            bindings = <
&none  &none  &none  &none  &none                      &mkp MB4  &mkp MB1  &sl_sp 2 0  &mkp MB2  &mkp MB5
&none  &none  &none  &none  &none                      &none     &none     &none       &none     &none
&none  &none  &none  &none  &none                      &none     &none     &none       &none     &none
&none  &none  &none  &none  &none  &none    &mkp MCLK  &none     &none     &none       &none     &none
            >;
        };

        layer_2 {
            display-name = "Arrow";
            bindings = <
&msc SCRL_LEFT  &msc SCRL_UP  &none      &msc SCRL_DOWN  &msc SCRL_RIGHT                  &none     &ctpgup         &kp UP_ARROW  &ctpgdn    &none
&kp LEFT_WIN    &kp LALT      &kp LCTRL  &kp LEFT_SHIFT  &none                            &kp HOME  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &kp END
&none           &none         &none      &none           &none                            &none     &none           &none         &none      &none
&none           &none         &none      &none           &none            &none    &none  &ctrlW    &none           &none         &none      &none
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "NUM";
            bindings = <
&none         &msc SCRL_UP  &none         &msc SCRL_DOWN  &none                               &kp N0           &kp N7        &kp N8        &kp N9        &kp GRAVE
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL     &kp LEFT_SHIFT  &none                               &kp N0           &kp NUMBER_4  &kp N5        &kp N6        &kp PERIOD
&none         &none         &none         &none           &none                               &kp N0           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
&none         &none         &kp NUMBER_0  &none           &kp SPACE  &none    &msc SCRL_LEFT  &msc SCRL_RIGHT  &none         &none         &none         &none
            >;
        };

        layer_4 {
            display-name = "FUNCTION";
            bindings = <
&none        &ctpgup  &none  &ctpgdn  &none                   &kp F10  &kp F7  &kp F8  &kp F9  &none
&none        &none    &none  &none    &none                   &kp F11  &kp F4  &kp F5  &kp F6  &none
&none        &none    &none  &none    &none                   &kp F12  &kp F1  &kp F2  &kp F3  &none
&bootloader  &none    &none  &none    &none  &none    &calte  &evalue  &none   &none   &none   &bootloader
            >;
        };

        layer_5 {
            display-name = "Snipe";
            bindings = <
&none         &ctpgup       &none      &ctpgdn         &none                    &msc SCRL_LEFT  &mkp MB1  &none  &mkp MB2  &msc SCRL_RIGHT
&kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none                    &msc SCRL_UP    &none     &none  &none     &msc SCRL_DOWN
&none         &none         &none      &none           &none                    &none           &none     &none  &none     &none
&none         &none         &none      &none           &none  &none    &ctrl_w  &mkp MB4        &none     &none  &none     &none
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &to 5   &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
