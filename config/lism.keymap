    combos {
        compatible = "zmk,combos";

        af4 {
            bindings = <&endapp>;
            key-positions = <16 37>;
        };

        CW {
            bindings = <&C_W>;
            key-positions = <6 7>;
        };

        SK {
            bindings = <&sk LSHFT>;
            key-positions = <16 17>;
        };

        IME {
            bindings = <&kp GRAVE>;
            key-positions = <13 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&L_HRM LWIN Q  &L_HRM LALT W    &L_HRM LCTRL E  &L_HRM LSHIFT R  &kp T                                           &kp Y                &R_HRM RSHFT U  &R_HRM RCTRL I  &R_HRM RIGHT_ALT O  &R_HRM RIGHT_WIN P
&kp A          &kp S            &kp D           &kp F            &kp G                                           &kp H                &kp J           &kp K           &kp L               &HIUS
&kp Z          &kp X            &kp C           &kp V            &kp B                                           &kp N                &kp M           &comSEMI        &periCOR            &SLPL
&kp TAB        &kp PRINTSCREEN  &mkp MB2        &mkp MB1         &L_THUMB 5 LEFT_ALT  &L_THUMB 6 LCTRL    &SQDQ  &R_Th_space 2 SPACE  &none           &none           &none               &kp ENTER
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        AML {
            display-name = "Mouse";
            bindings = <
&kp LWIN  &kp LEFT_ALT  &kp LCTRL  &kp LSHFT  &none                     &none     &none     &none  &none          &none
&none     &none         &none      &none      &none                     &kp HOME  &mkp MB1  &none  &SL_SP3 2 MB2  &kp END
&none     &none         &none      &none      &none                     &none     &none     &none  &none          &none
&none     &none         &none      &none      &none  &none    &mkp MB5  &mkp MB4  &none     &none  &none          &none
            >;
        };

        BASIC {
            display-name = "Arrow";
            bindings = <
&kp LWIN    &SP_CTPGUP LALT 0  &SP_CTUP LCTRL 0  &SP_CTPGDN LSHFT 0  &none                      &altesc   &kp BACKSPACE   &kp UP_ARROW    &kp ESCAPE  &saltesc
&shiftHOME  &ctlt              &ctdn             &ctrt               &shiftEND                  &wintab   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT   &pl
&none       &cthome            &calte            &ctend              &none                      &kp RWIN  &ctpgup         &kp DELETE      &ctpgdn     &kp SLASH
&none       &none              &evalue           &kp HOME            &kp END    &none    &none  &none     &none           &none           &none       &none
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        NUM_FUN_1 {
            display-name = "NUM";
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5                    &kp F6         &kp F7     &kp F8     &kp F9  &kp F10
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                    &kp NUMBER_6   &kp N7     &kp N8     &kp N9  &kp N0
&kp DOT       &kp EQUAL     &none         &none         &dollar                   &plus          &kp MINUS  &kp SLASH  &aster  &kp ENTER
&none         &none         &none         &none         &none    &VBE    &kp F12  &kp BACKSPACE  &none      &none      &none   &kp SLASH
            >;
        };

        layer_5 {
            display-name = "Snipe";
            bindings = <
&none  &none  &none  &none  &none                     &ctup    &none     &none     &none  &none
&none  &none  &none  &none  &none                     &none    &mkp MB4  &mkp MB5  &none  &none
&none  &none  &none  &none  &none                     &none    &altesc   &none     &none  &none
&none  &none  &none  &none  &none  &none    &kp HOME  &kp END  &none     &none     &none  &none
            >;
        };

        SC_SYMBOL {
            display-name = "FUNCTION";
            bindings = <
&none               &none  &none     &none     &none                            &kp INTERNATIONAL_3  &kp LBKT  &kp RBKT      &kp NUHS      &kp EQUAL
&kp K_CONTEXT_MENU  &none  &mkp MB4  &mkp MB5  &kp PRINTSCREEN                  &dollar              &anp      &lk           &rk           &eql
&none               &none  &none     &none     &none                            &percent             &hush     &L_yamakakko  &R_yamakakko  &exc
&none               &none  &none     &none     &none            &none    &none  &none                &none     &none         &none         &none
            >;
        };

        NUM_FUN_2 {
            bindings = <
&none    &kp F1  &kp F2  &kp F3  &none                    &none    &kp N1  &kp N2  &kp N3  &none
&kp F10  &kp F4  &kp F5  &kp F6  &kp F11                  &kp DOT  &kp N4  &kp N5  &kp N6  &kp N0
&kp F12  &kp F7  &kp F8  &kp F9  &none                    &none    &kp N7  &kp N8  &kp N9  &none
&none    &none   &none   &none   &none    &none    &none  &none    &none   &none   &none   &none
            >;
        };
    };
};
