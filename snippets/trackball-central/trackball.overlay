#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
&spi0 {
    status = "okay";

    trackball_central: trackball@1 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};

// ペリフェラル（split経由）のリスナーを有効化
&peripheral_listener {
    status = "okay";
};

/ {
    zip_keybind_keys: zip_keybind_keys {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&altesc>,
                  <&saltesc>,
                  <&ctpgup>,
                  <&ctpgdn>;
        tick = <70>;
        wait-ms = <0>;
        tap-ms = <10>;
         mode = <1>;
        // threshold = <10>
        // max_threshold = <200>
        // max_pending_activations = <10>
    };
     zip_keybind_tab: zip_keybind_tab {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp END>,
                  <&kp HOME>,
                  <&cthome>,
                  <&ctend>;
        tick = <70>;
        wait-ms = <0>;
        tap-ms = <10>;
         mode = <1>;
        // threshold = <10>
        // max_threshold = <200>
        // max_pending_activations = <10>
    };
   input_processors {
        zip_scroll_x_scaler: zip_scroll_x_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_HWHEEL>;
            track-remainders;
        };

        zip_scroll_y_scaler: zip_scroll_y_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };

};

// セントラルのリスナーを有効化し、deviceを紐付け
&central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors = 
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_temp_layer 1 10000>;

    vertical_scroller {
        layers = <5>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_x_scaler 0 1
            &zip_scroll_scaler 1 16
        >;
    };

    horizontal_scroller {
        layers = <6>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_y_scaler 0 1
            &zip_scroll_scaler 1 16
        >;
    };

    appchange {
        layers = <3>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
             &zip_keybind_keys>;
             process-next;
    };

    appchange-prevent-move {
        layers = <3>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

    homeend {
        layers = <4>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
             &zip_keybind_tab>;
             process-next;
    };

    homeend-prevent-move {
        layers = <4>;
        input-processors = <&zip_xy_scaler 0 1>;
    };

};

&zip_temp_layer {
    require-prior-idle-ms = <400>;

    excluded-positions = <
        1 2 3 4 5 6 8 9
        // 16 17 18 19
        25 26 27 28 29
    >;
};
